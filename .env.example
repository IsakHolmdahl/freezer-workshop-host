# Copy to .env and fill in. Never commit .env.

# Shared with the attendees: opens the sign-up page and the map.
SITE_PASSWORD=choose-a-word
# Organisers only: the same login page, but adds the controls on the map.
ADMIN_PASSWORD=choose-a-long-one

# The public address. A host name gives HTTPS automatically; ":80" serves plain HTTP on any address.
# Without a domain of your own, use the VM's public IP with dashes and .sslip.io:
#   SITE_ADDRESS=13-48-1-23.sslip.io
SITE_ADDRESS=:80

# Optional pacing (seconds). Defaults in src/freezerhost/config.py.
# ATTACK_AUTO=true            # false: waves start only when you press "Release next wave"
# ATTACK_DELAY_SECONDS=60     # all freezers updated -> first wave
# WAVE_INTERVAL_SECONDS=240   # between waves
# OFFLINE_RETURN_SECONDS=180  # how long frys-07 stays offline after the first install command
